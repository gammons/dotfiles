{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Omarchyy",
  "author": "@bypass_",
  "themes": [
    {
      "name": "Omarchy",
      "appearance": "dark",
      "style": {
        "background": "#2d294090",
        "editor.background": "#2d294090",
        "editor.foreground": "#6096fd",
        "text": "#6096fd",
        "text.muted": "#6096fd70",
        "text.ignored": "#6096fd40",
        "text.placeholder": "#6096fd50",
        "ignored": "#6096fd30",
        "element.hover": "#6096fd30",
        "ghost_element.hover": "#68476430",
        "ghost_element.selected": "#68476430",
        "ghost_element.active": "#68476460",
        "border": "#2d2940",
        "editor.highlighted_line.background": "#68476410",
        "editor.active_line.background": "#68476410",
        "panel.background": "#2d294090",
        "title_bar.background": "#2d294090",
        "title_bar.inactive_background": "#2d294090",
        "status_bar.background": "#2d294090",
        "drop_target.background": "#2d294090",
        "elevated_surface.background": "#2d2940",
        "toolbar.background": "#2d294090",
        "tab_bar.background": "#2d294090",
        "tab.inactive_background": "#2d294090",
        "tab.active_background": "#68476430",
        "scrollbar.track.background": "transparent",
        "scrollbar.track.border": "#2d2940",
        "scrollbar.thumb.background": "#6096fd",
        "editor.gutter.background": "#2d294090",
        "terminal.background": "#2d294010",
        "terminal.foreground": "#6096fd",
        "terminal.dim_foreground": "#6096fd",
        "terminal.bright_foreground": "#6096fd",
        "terminal.ansi.black": "#2d2940",
        "terminal.ansi.red": "#C0685F",
        "terminal.ansi.green": "#965f81",
        "terminal.ansi.yellow": "#fca766",
        "terminal.ansi.blue": "#7b79a4",
        "terminal.ansi.magenta": "#987195",
        "terminal.ansi.cyan": "#7c79a5",
        "terminal.ansi.white": "#6096fd",
        "terminal.ansi.bright_black": "#684764",
        "terminal.ansi.bright_red": "#ee897d",
        "terminal.ansi.bright_green": "#bb90a1",
        "terminal.ansi.bright_yellow": "#ffd46b",
        "terminal.ansi.bright_blue": "#a09bd3",
        "terminal.ansi.bright_magenta": "#c192c0",
        "terminal.ansi.bright_cyan": "#a19bd4",
        "terminal.ansi.bright_white": "#00ffd2",
        "modified": "#C0685F",
        "syntax": {
          "attribute": {
            "color": "#6096fd"
          },
          "boolean": {
            "color": "#965f81"
          },
          "comment": {
            "color": "#684764"
          },
          "comment.doc": {
            "color": "#684764"
          },
          "constant": {
            "color": "#bb90a1"
          },
          "function": {
            "color": "#a19bd4"
          },
          "keyword": {
            "color": "#7b79a4"
          },
          "number": {
            "color": "#987195"
          },
          "operator": {
            "color": "#7b79a4"
          },
          "string": {
            "color": "#C0685F"
          },
          "variable": {
            "color": "#965f81"
          }
        },
        "players": [
          {
            "cursor": "#6096fd",
            "background": "#2d2940",
            "selection": "#6096fd30"
          }
        ]
      }
