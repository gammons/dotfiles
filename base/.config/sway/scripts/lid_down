#!/bin/bash

touch /tmp/lid_down

exec 9>/tmp/lid.lock
flock 9

exec >> ~/.cache/lid_debug.log 2>&1
echo "=== lid_down $(date) pid=$$ ==="
swaymsg -t get_outputs | jq '[.[] | {name, active}]'

# Count active external monitors (exclude eDP and HEADLESS outputs)
external_count=$(swaymsg -t get_outputs | jq '[.[] | select(.active == true and (.name | test("^eDP|^HEADLESS") | not))] | length')
echo "external_count=$external_count"

if [ "$external_count" -gt 0 ]; then
  echo "taking multi-monitor path"
  swaymsg output eDP-1 disable
  swaymsg output DP-1 scale 1.0 pos 0 0 res 3840x2160@144Hz
  swaymsg output DP-2 scale 1.0 pos 0 0 res 3840x2160@144Hz
  swaymsg output DP-3 scale 1.0 pos 0 0 res 3840x2160@144Hz
else
  echo "taking suspend path"
  qs ipc -c noctalia-shell call lockScreen lock &
  echo "lock launched (bg), exit code: $?"
  sleep 1
  echo "about to suspend"
  if systemctl suspend; then
    echo "suspend exit code: 0"
  else
    rc=$?
    echo "suspend FAILED, exit code: $rc; recovering eDP-1"
    swaymsg output eDP-1 enable
    swaymsg output eDP-1 power on
  fi
fi
echo "=== done ==="
