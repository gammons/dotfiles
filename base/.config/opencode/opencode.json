{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (home server)",
      "options": {
        "baseURL": "http://192.168.1.226:11434/v1"
      },
      "models": {
        "gemma4:12b": { "name": "Gemma 4 12B" }
      }
    }
  },
  "plugin": [
    "opencode-claude-auth@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "oauth": {}
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com/",
      "oauth": {}
    },
    "google-ads": {
      "type": "local",
      "command": ["/home/grant/local_code/google-ads-mcp/.venv/bin/google-ads-mcp"],
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/home/grant/.config/google-ads-mcp/adc.json",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "kJqN3_9zbI5w5zNlJ0ufwg",
        "GOOGLE_CLOUD_PROJECT": "truelist"
      }
    },
    "Truelist": {
      "type": "remote",
      "url": "https://api.truelist.io/mcp",
      "oauth": {}
    },
    "userevidence": {
      "type": "remote",
      "url": "https://app.userevidence.com/mcp?audience=customer",
      "oauth": {}
    }
  }
}
