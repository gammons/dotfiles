{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "agent": {
    "plan": { "model": "anthropic/claude-opus-5" },
    "build": { "model": "anthropic/claude-sonnet-4-5" },
    "general": { "model": "anthropic/claude-sonnet-4-5" },
    "explore": { "model": "anthropic/claude-haiku-4-5" },
    "scout": { "model": "anthropic/claude-haiku-4-5" }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (home server)",
      "options": {
        "baseURL": "http://192.168.1.226:11434/v1"
      },
      "models": {
        "gemma4:12b": { "name": "Gemma 4 12B" }
      }
    }
  },
  "plugin": [
    "opencode-claude-auth@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": {
      "*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "env:$TMPDIR": "allow",
      "env:$TMPDIR/*": "allow"
    },
  },
  "mcp": {
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "oauth": {}
    },
    "stripe-live": {
      "type": "remote",
      "url": "https://mcp.stripe.com/",
      "oauth": {}
    },
    "Truelist": {
      "type": "remote",
      "url": "https://api.truelist.io/mcp",
      "oauth": {}
    },
    "userevidence": {
      "type": "remote",
      "url": "https://app.userevidence.com/mcp?audience=customer",
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "oauth": {}
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {}
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "vanta": {
      "type": "remote",
      "url": "https://mcp.vanta.com/mcp",
      "oauth": {}
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {}
    }
  }
}
